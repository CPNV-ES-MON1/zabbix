# ============================================================
# Configuration Zabbix Agent2 - Exemple
# Copiez ce fichier vers .env et renseignez vos propres valeurs
# ============================================================

ZABBIX_SERVER="10.0.1.x"
ZABBIX_SERVER_PORT="10051"
ZABBIX_API_TOKEN="votre_token_api_ici"

AGENT_PORT="10050"
CONTAINER_NAME="zabbix-agent2"
ZBX_IMAGE="zabbix/zabbix-agent2:latest"

HOST_GROUP_NAME="Linux servers"
TEMPLATE_NAME="Linux by Zabbix agent"
