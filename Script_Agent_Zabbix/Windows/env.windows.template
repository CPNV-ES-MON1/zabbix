# ==============================
# Configuration Zabbix Agent Windows
# ==============================

# IP du serveur Zabbix
ZABBIX_SERVER_IP=

# Hostname du client
ZABBIX_HOSTNAME=

# Port de l'agent Zabbix
ZABBIX_AGENT_PORT=10050

# Version de Zabbix
ZABBIX_VERSION=7.0

# Service Windows à surveiller
MONITORED_SERVICE=Schedule

# Utilisateur système Zabbix
ZABBIX_USER=zabbix

# API Zabbix
ZABBIX_API_URL=http://<ZABBIX_SERVER_IP>/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=

# ID du groupe d'hôtes Zabbix (Linux servers = 2 par défaut)
ZABBIX_HOSTGROUP_ID=2

# ID du template à associer (Template OS Windows by Zabbix agent = 10081 par défaut)
ZABBIX_TEMPLATE_ID=10081
